<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <!-- The user's mascot on one side, the current task on the other. -->
    <ImageView
        android:id="@+id/widget_mascot"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_mascot_male" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

    <TextView
        android:id="@+id/widget_focus_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="@string/widget_focus_label"
        android:textAllCaps="true"
        android:textColor="#6B6B6B"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_focus_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_empty_focus"
        android:textColor="#F5F5F5"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_focus_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#A1A1A1"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Type opens the quick text box; Talk opens voice capture in the app. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_button"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="@string/widget_type"
            android:textColor="#F5F5F5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_talk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="@string/widget_talk"
            android:textColor="#F5F5F5"
            android:textSize="12sp" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
