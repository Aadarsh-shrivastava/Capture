<?xml version="1.0" encoding="utf-8"?>
<!-- "Save to Capture" from any app's share menu: what was shared, an optional note, and which basket (type) it goes in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/share_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/share_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/share_cancel"
            android:textColor="@color/share_muted"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/share_title"
            android:textColor="@color/share_text"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/share_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/share_field"
        android:maxLines="5"
        android:ellipsize="end"
        android:padding="12dp"
        android:textColor="@color/share_text"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/share_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/share_field"
        android:hint="@string/share_note_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="3"
        android:padding="12dp"
        android:textColor="@color/share_text"
        android:textColorHint="@color/share_muted"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/share_save_to"
        android:textColor="@color/share_muted"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- One row per basket (your item types), filled in code; tapping one saves into it. -->
    <LinearLayout
        android:id="@+id/share_baskets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />
</LinearLayout>
