<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#141414"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/widget_capture_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_field"
        android:gravity="top|start"
        android:padding="14dp"
        android:hint="@string/widget_input_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:minLines="3"
        android:textColor="#F5F5F5"
        android:textColorHint="#6B6B6B"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_capture_talk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:backgroundTint="#2A2A2A"
            android:text="@string/widget_talk_button"
            android:textColor="#F5F5F5" />

        <Button
            android:id="@+id/widget_capture_submit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#E5E5E5"
            android:text="@string/widget_submit"
            android:textColor="#0A0A0A" />
    </LinearLayout>
</LinearLayout>
